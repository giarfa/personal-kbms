APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Personal KBMS ---
# ICS feed URL to sync (US-003). No default — must be set.
KBMS_ICS_URL=
# Minutes between calendar syncs (US-001, US-003). Default: 15.
KBMS_ICS_SYNC_MINUTES=15
# Days in the past the agenda/sync window covers (US-003, US-005). Default: 90.
KBMS_ICS_WINDOW_PAST_DAYS=90
# Days in the future the agenda/sync window covers (US-003, US-005). Default: 180.
KBMS_ICS_WINDOW_FUTURE_DAYS=180
# Absolute path to the operator's transcript directory (US-006). No default — must be set.
KBMS_TRANSCRIPTS_PATH=
# Transcript filename convention (US-006); see decision journal "transcript filename convention".
KBMS_TRANSCRIPT_PATTERN={date}-{time}-{slug}
# Two-argument launcher script invoked with (context file path, question) (US-007, US-009). No default — must be set.
KBMS_CLAUDE_LAUNCHER=
# Outlook deep-link URL template, used when the feed has no native link (US-005). No default.
KBMS_OUTLOOK_URL_TEMPLATE=
# Operator timezone, also bound to app.timezone (US-001). Default: Europe/Rome.
KBMS_TIMEZONE=Europe/Rome
# Set true to lift the loopback-only access control (US-001). Default: false.
KBMS_ALLOW_NON_LOOPBACK=false
